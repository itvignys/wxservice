/* 全局样式 - GPU算力回收小程序（明亮科技主题） */
page {
  /* 主题色：生态绿（呼应回收/循环利用） */
  --primary: #2BB673;
  --primary-dark: #1a9e5e;
  --primary-light: #E8F8F0;
  --secondary: #0D1B2A;
  --accent: #FF9500;
  --success: #34C759;
  --warning: #FF9500;
  --danger: #FF3B30;
  --info: #4A90D9;

  /* 背景色 */
  --bg-page: #F5F7FA;
  --bg-card: #FFFFFF;
  --bg-navbar: #0D1B2A;
  --bg-gray: #F2F4F7;

  /* 文字色 */
  --text-primary: #1D1D1F;
  --text-secondary: #86868B;
  --text-tertiary: #C7C7CC;
  --text-inverse: #FFFFFF;

  /* 边框 */
  --border-color: #E5E5EA;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
}

/* ============ 通用卡片 ============ */
.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--primary), var(--primary-dark));
  margin-right: 16rpx;
  border-radius: 4rpx;
}

/* ============ 按钮 ============ */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(43, 182, 115, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: var(--bg-card);
  color: var(--primary);
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  border: 2rpx solid var(--primary);
}

.btn-secondary::after {
  border: none;
}

.btn-disabled {
  background: var(--text-tertiary);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  border: none;
}

/* ============ 标签 ============ */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  font-weight: 500;
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-success {
  background: rgba(52, 199, 89, 0.12);
  color: var(--success);
}

.tag-warning {
  background: rgba(255, 149, 0, 0.12);
  color: var(--warning);
}

.tag-danger {
  background: rgba(255, 59, 48, 0.12);
  color: var(--danger);
}

.tag-info {
  background: rgba(74, 144, 217, 0.12);
  color: var(--info);
}

/* ============ 分隔线 ============ */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

/* ============ 文本工具 ============ */
.text-primary { color: var(--primary); }
.text-secondary { color: var(--text-secondary); }
.text-danger { color: var(--danger); }
.text-warning { color: var(--warning); }
.text-bold { font-weight: 600; }
.text-center { text-align: center; }

.price {
  color: var(--danger);
  font-weight: 700;
}

.price-large {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--primary);
}

/* ============ 底部安全栏 ============ */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============ 底部固定操作栏 ============ */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-card);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0,0,0.06);
  z-index: 100;
}

/* ============ 动画 ============ */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.slide-up {
  animation: slideUp 0.35s ease-out;
}

/* ============ 空状态 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state .empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
