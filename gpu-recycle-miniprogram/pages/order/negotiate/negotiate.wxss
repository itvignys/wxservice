/* 协商页样式 */
.container { display: flex; flex-direction: column; height: 100vh; background: var(--bg-page); }

/* 报价信息 */
.price-info { display: flex; background: var(--bg-card); padding: 24rpx 0; box-shadow: var(--shadow-sm); }
.price-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.price-label { font-size: 22rpx; color: var(--text-secondary); margin-bottom: 8rpx; }
.price-val { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.price-val.highlight { color: var(--danger); font-size: 34rpx; }

/* 聊天区 */
.chat-area { flex: 1; padding: 24rpx; }
.msg-item { display: flex; margin-bottom: 24rpx; }
.msg-item.user { flex-direction: row-reverse; }
.msg-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--bg-gray); display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.msg-bubble { max-width: 480rpx; background: var(--bg-card); border-radius: 16rpx; padding: 20rpx 24rpx; margin: 0 16rpx; box-shadow: var(--shadow-sm); }
.msg-item.user .msg-bubble { background: var(--primary-light); }
.msg-text { font-size: 28rpx; color: var(--text-primary); line-height: 1.5; }
.msg-price { font-size: 30rpx; font-weight: 700; color: var(--danger); margin-top: 8rpx; }
.msg-time { font-size: 20rpx; color: var(--text-tertiary); margin-top: 8rpx; }

/* 快捷操作 */
.quick-actions { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 16rpx 24rpx; background: var(--bg-card); }
.quick-btn { font-size: 24rpx; color: var(--primary); background: var(--primary-light); padding: 12rpx 24rpx; border-radius: 24rpx; }

/* 输入栏 */
.input-bar { display: flex; align-items: center; padding: 16rpx 24rpx; background: var(--bg-card); box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); }
.msg-input { flex: 1; background: var(--bg-gray); border-radius: 32rpx; padding: 18rpx 28rpx; font-size: 28rpx; }
.send-btn { background: var(--primary); color: #fff; padding: 16rpx 32rpx; border-radius: 32rpx; font-size: 28rpx; font-weight: 600; margin-left: 16rpx; }
