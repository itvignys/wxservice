<!-- 订单详情 -->
<view class="container" wx:if="{{order}}">
  <!-- 状态卡片 -->
  <view class="status-card">
    <view class="status-bg"></view>
    <view class="status-content">
      <view class="status-text" style="color:{{statusColor}}">{{statusText}}</view>
      <view class="status-desc">{{statusDesc}}</view>
      <!-- 进度时间轴 -->
      <view class="timeline">
        <view class="timeline-item {{index <= currentStepIndex ? 'active' : ''}}" wx:for="{{timeline}}" wx:key="status">
          <view class="timeline-dot">{{item.icon}}</view>
          <view class="timeline-label">{{item.label}}</view>
          <view class="timeline-line" wx:if="{{index < timeline.length - 1}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 价格信息卡 -->
  <view class="card">
    <view class="card-title">价格信息</view>
    <view class="price-row">
      <text class="row-label">预估回收价</text>
      <text class="row-value">¥{{estimatedPriceText}}</text>
    </view>
    <view class="price-row" wx:if="{{order.inspectionPrice}}">
      <text class="row-label">验机报价</text>
      <text class="row-value {{order.inspectionPrice < order.estimatedPrice ? 'text-danger' : ''}}">¥{{inspectionPriceText}}</text>
    </view>
    <view class="price-row" wx:if="{{order.finalPrice}}">
      <text class="row-label">最终成交价</text>
      <text class="row-value price">¥{{finalPriceText}}</text>
    </view>
  </view>

  <!-- 设备信息卡 -->
  <view class="card">
    <view class="card-title">设备信息</view>
    <view class="info-row"><text class="info-label">品类</text><text class="info-value">{{order.categoryName}}</text></view>
    <view class="info-row"><text class="info-label">型号</text><text class="info-value">{{order.modelName}}</text></view>
    <view class="info-row"><text class="info-label">规格</text><text class="info-value">{{order.modelSpec}}</text></view>
    <view class="info-row" wx:if="{{conditionText}}"><text class="info-label">成色</text><text class="info-value">{{conditionText}}</text></view>
    <view class="info-row" wx:if="{{order.configText}}"><text class="info-label">配置</text><text class="info-value">{{order.configText}}</text></view>
    <!-- 设备照片 -->
    <view class="photo-grid" wx:if="{{order.images && order.images.length > 0}}">
      <image wx:for="{{order.images}}" wx:key="index" src="{{item}}" mode="aspectFill" class="photo-item" bindtap="previewPhoto" data-index="{{index}}"></image>
    </view>
  </view>

  <!-- 回收方式 -->
  <view class="card">
    <view class="card-title">回收方式</view>
    <view class="info-row"><text class="info-label">方式</text><text class="info-value">{{methodText}}</text></view>
    <view class="info-row"><text class="info-label">联系人</text><text class="info-value">{{order.contactName}}</text></view>
    <view class="info-row"><text class="info-label">联系电话</text><text class="info-value" bindtap="callPhone">{{order.contactPhone}}</text></view>
    <view class="info-row" wx:if="{{order.address}}"><text class="info-label">地址</text><text class="info-value">{{order.address}}</text></view>
    <view class="info-row" wx:if="{{order.appointmentTime}}"><text class="info-label">预约时间</text><text class="info-value">{{order.appointmentTime}}</text></view>
    <view class="info-row" wx:if="{{order.store}}"><text class="info-label">网点</text><text class="info-value">{{order.store}}</text></view>
  </view>

  <!-- 验机报告入口 -->
  <view class="entry-card" wx:if="{{showInspection}}" bindtap="goInspection">
    <view class="entry-icon">🔍</view>
    <view class="entry-info">
      <view class="entry-title">验机报告</view>
      <view class="entry-desc">{{order.inspectionPrice ? '查看详细验机报告' : '工程师验机中，报告出具后可查看'}}</view>
    </view>
    <view class="entry-arrow">></view>
  </view>

  <!-- 协商入口 -->
  <view class="entry-card negotiate" wx:if="{{order.status === 'negotiating'}}" bindtap="goNegotiate">
    <view class="entry-icon">💬</view>
    <view class="entry-info">
      <view class="entry-title">价格协商</view>
      <view class="entry-desc">客服正在与您协商，点击进入</view>
    </view>
    <view class="entry-arrow">></view>
  </view>

  <view style="height:140rpx"></view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar safe-bottom" wx:if="{{actions.length > 0}}">
    <view class="action-btn secondary" wx:if="{{actions.includes('contact')}}" bindtap="callService">联系客服</view>
    <view class="action-btn secondary" wx:if="{{actions.includes('cancel')}}" bindtap="cancelOrder">取消订单</view>
    <view class="action-btn secondary" wx:if="{{actions.includes('reject')}}" bindtap="rejectPrice">价格不合适</view>
    <view class="action-btn primary" wx:if="{{actions.includes('confirm')}}" bindtap="confirmPrice">确认价格</view>
    <view class="action-btn primary" wx:if="{{actions.includes('payment')}}" bindtap="confirmPayment">确认收款</view>
  </view>
</view>
