/* 首页样式 */
.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--bg-card);
}

.brand {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--secondary);
}

.service-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--primary-light);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--primary);
}

.service-icon {
  font-size: 28rpx;
}

/* Banner */
.banner {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #2BB673 0%, #1a9e5e 50%, #0D5C3E 100%);
}

.banner-content {
  position: relative;
  padding: 48rpx 36rpx;
  color: #fff;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 36rpx;
}

.banner-stats {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
  margin: 0 32rpx;
}

.banner-btn {
  display: inline-block;
  background: #fff;
  color: var(--primary);
  padding: 20rpx 48rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

/* 通用 section */
.section {
  margin-top: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 热门机型横向滚动 */
.hot-scroll {
  white-space: nowrap;
  padding: 0 24rpx 8rpx;
}

.hot-card {
  display: inline-block;
  width: 280rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-right: 20rpx;
  box-shadow: var(--shadow-sm);
  vertical-align: top;
  white-space: normal;
}

.hot-brand {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.hot-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.hot-spec {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.hot-price-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  display: block;
}

.hot-price-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--danger);
}

.hot-action {
  margin-top: 16rpx;
  text-align: center;
  background: var(--primary-light);
  color: var(--primary);
  padding: 12rpx 0;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* 回收流程 */
.flow-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  margin: 0 24rpx;
  padding: 36rpx 24rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
}

.flow-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.flow-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.flow-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.flow-desc {
  font-size: 20rpx;
  color: var(--text-secondary);
  text-align: center;
}

.flow-arrow {
  position: absolute;
  right: -16rpx;
  top: 28rpx;
  color: var(--primary);
  font-size: 24rpx;
}

/* 平台承诺 */
.promise-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 24rpx;
}

.promise-item {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.promise-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.promise-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.promise-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* 品类网格 */
.cat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  padding: 0 24rpx;
}

.cat-item {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.cat-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin: 0 auto 12rpx;
}

.cat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.cat-desc {
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 0 32rpx;
  margin-top: 24rpx;
}

.footer-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.8;
}
