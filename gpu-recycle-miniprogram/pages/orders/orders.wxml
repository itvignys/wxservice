<!-- 订单列表 -->
<view class="container">
  <!-- 状态筛选Tab -->
  <scroll-view scroll-x class="status-tabs" enhanced show-scrollbar="{{false}}">
    <view class="status-tab {{currentTab === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" bindtap="switchTab" data-tab="{{item.value}}">
      {{item.label}}
      <text class="tab-count" wx:if="{{item.count > 0}}">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{filteredOrders.length > 0}}">
    <view class="order-card fade-in" wx:for="{{filteredOrders}}" wx:key="id" bindtap="goDetail" data-orderno="{{item.orderNo}}">
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status" style="color:{{item.statusColor}}">{{item.statusText}}</text>
      </view>
      <view class="order-body">
        <view class="order-model">{{item.modelName}}</view>
        <view class="order-spec">{{item.modelSpec}}</view>
        <view class="order-tags">
          <text class="tag tag-primary">{{item.methodText}}</text>
          <text class="tag" wx:if="{{item.conditionText}}">{{item.conditionText}}</text>
        </view>
      </view>
      <view class="order-footer">
        <view class="order-price">
          <text class="price-label">预估价</text>
          <text class="price-val">¥{{item.priceText}}</text>
        </view>
        <view class="order-time">{{item.timeText}}</view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">加载中...</view>
    <view class="load-more" wx:else>没有更多了</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-icon">📦</view>
    <view class="empty-text">暂无回收订单</view>
    <view class="empty-btn" bindtap="goRecycle">立即估价回收</view>
  </view>
</view>
