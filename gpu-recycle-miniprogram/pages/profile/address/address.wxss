/* 地址列表页样式 */
.container { min-height: 100vh; }
.addr-list { padding: 24rpx; }
.addr-card { background: var(--bg-card); border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: var(--shadow-sm); }
.addr-info { }
.addr-name-row { display: flex; align-items: center; margin-bottom: 12rpx; }
.addr-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); margin-right: 20rpx; }
.addr-phone { font-size: 26rpx; color: var(--text-secondary); }
.addr-default { font-size: 20rpx; color: var(--primary); background: var(--primary-light); padding: 4rpx 12rpx; border-radius: 6rpx; margin-left: 12rpx; }
.addr-detail { font-size: 26rpx; color: var(--text-secondary); line-height: 1.5; }
.addr-actions { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border-color); }
.addr-btn { font-size: 24rpx; color: var(--primary); padding: 8rpx 20rpx; border: 2rpx solid var(--primary); border-radius: 24rpx; }
.addr-btn.delete { color: var(--danger); border-color: var(--danger); }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0; }
.empty-icon { font-size: 120rpx; opacity: 0.2; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: var(--text-secondary); }

.bottom-bar { background: var(--bg-card); }
.add-btn { flex: 1; text-align: center; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; padding: 24rpx; border-radius: 48rpx; font-size: 30rpx; font-weight: 600; }
