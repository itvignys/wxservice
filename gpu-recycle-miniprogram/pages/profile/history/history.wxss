/* 回收记录页样式 */
.container { min-height: 100vh; }
.summary-card { display: flex; background: var(--bg-card); margin: 24rpx; border-radius: 16rpx; padding: 32rpx 0; box-shadow: var(--shadow-sm); }
.summary-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.summary-num { font-size: 40rpx; font-weight: 800; color: var(--primary); }
.summary-label { font-size: 22rpx; color: var(--text-secondary); margin-top: 8rpx; }

.record-list { padding: 0 24rpx; }
.record-card { background: var(--bg-card); border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: var(--shadow-sm); }
.record-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.record-model { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.record-status { font-size: 26rpx; font-weight: 600; }
.record-spec { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 16rpx; }
.record-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; border-top: 1rpx solid var(--border-color); }
.record-price { font-size: 32rpx; font-weight: 700; color: var(--danger); }
.record-time { font-size: 22rpx; color: var(--text-tertiary); }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 120rpx; opacity: 0.2; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: var(--text-secondary); margin-bottom: 32rpx; }
.empty-btn { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; padding: 20rpx 56rpx; border-radius: 48rpx; font-size: 28rpx; font-weight: 600; }
