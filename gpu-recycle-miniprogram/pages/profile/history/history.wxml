<!-- 回收记录 -->
<view class="container">
  <!-- 统计概览 -->
  <view class="summary-card">
    <view class="summary-item">
      <text class="summary-num">{{summary.count}}</text>
      <text class="summary-label">回收次数</text>
    </view>
    <view class="summary-item">
      <text class="summary-num">¥{{summary.amount}}</text>
      <text class="summary-label">回收总额</text>
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="record-list" wx:if="{{records.length > 0}}">
    <view class="record-card" wx:for="{{records}}" wx:key="id" bindtap="goDetail" data-orderno="{{item.orderNo}}">
      <view class="record-header">
        <text class="record-model">{{item.modelName}}</text>
        <text class="record-status" style="color:{{item.statusColor}}">{{item.statusText}}</text>
      </view>
      <view class="record-spec">{{item.modelSpec}}</view>
      <view class="record-footer">
        <text class="record-price">¥{{item.priceText}}</text>
        <text class="record-time">{{item.timeText}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <view class="empty-icon">📋</view>
    <view class="empty-text">暂无回收记录</view>
    <view class="empty-btn" bindtap="goRecycle">立即估价回收</view>
  </view>
</view>
