<!-- 个人中心 -->
<view class="container">
  <!-- 用户信息区 -->
  <view class="user-header">
    <view class="user-bg"></view>
    <view class="user-content">
      <view class="user-info" wx:if="{{userInfo}}" bindtap="editProfile">
        <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="user-detail">
          <view class="user-name">{{userInfo.nickname || '用户'}}</view>
          <view class="user-phone">{{userInfo.phone || '未绑定手机号'}}</view>
        </view>
        <view class="user-edit">编辑</view>
      </view>
      <view class="user-info" wx:else bindtap="goLogin">
        <view class="user-avatar default">👤</view>
        <view class="user-detail">
          <view class="user-name">点击登录</view>
          <view class="user-phone">登录后享受更多服务</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 回收统计 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.totalCount}}</text>
      <text class="stat-label">回收次数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.totalAmount}}</text>
      <text class="stat-label">回收金额(元)</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.activeCount}}</text>
      <text class="stat-label">进行中</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goAddress">
      <view class="menu-icon">📍</view>
      <text class="menu-name">地址管理</text>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goHistory">
      <view class="menu-icon">📋</view>
      <text class="menu-name">回收记录</text>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goPayment">
      <view class="menu-icon">🏦</view>
      <text class="menu-name">收款信息</text>
      <view class="menu-arrow">></view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="goAbout">
      <view class="menu-icon">ℹ️</view>
      <text class="menu-name">关于我们</text>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="goFeedback">
      <view class="menu-icon">💬</view>
      <text class="menu-name">意见反馈</text>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" bindtap="callService">
      <view class="menu-icon">📞</view>
      <text class="menu-name">联系客服</text>
      <view class="menu-text">13826580396</view>
      <view class="menu-arrow">></view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <view class="footer-text">杭州秀源智能科技</view>
    <view class="footer-text">服务热线：13826580396（9:00-21:00）</view>
  </view>
</view>
