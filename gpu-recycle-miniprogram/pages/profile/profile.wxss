/* 个人中心页样式 */
.container { min-height: 100vh; padding-bottom: 40rpx; }

/* 用户头部 */
.user-header { position: relative; overflow: hidden; }
.user-bg { position: absolute; top:0; left:0; right:0; height: 100%; background: linear-gradient(135deg, #0D1B2A 0%, #1a3a5c 100%); }
.user-content { position: relative; padding: 60rpx 32rpx 40rpx; }
.user-info { display: flex; align-items: center; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.1); }
.user-avatar.default { display: flex; align-items: center; justify-content: center; font-size: 56rpx; }
.user-detail { flex: 1; margin-left: 24rpx; }
.user-name { font-size: 36rpx; font-weight: 700; color: #fff; margin-bottom: 8rpx; }
.user-phone { font-size: 26rpx; color: rgba(255,255,255,0.7); }
.user-edit { font-size: 24rpx; color: #fff; border: 2rpx solid rgba(255,255,255,0.4); padding: 8rpx 20rpx; border-radius: 24rpx; }

/* 统计卡 */
.stats-card { display: flex; align-items: center; background: var(--bg-card); margin: -24rpx 24rpx 0; border-radius: 20rpx; padding: 32rpx 0; box-shadow: var(--shadow-md); position: relative; z-index: 2; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 40rpx; font-weight: 800; color: var(--primary); }
.stat-label { font-size: 22rpx; color: var(--text-secondary); margin-top: 8rpx; }
.stat-divider { width: 1rpx; height: 60rpx; background: var(--border-color); }

/* 菜单 */
.menu-card { background: var(--bg-card); margin: 24rpx; border-radius: 16rpx; box-shadow: var(--shadow-sm); overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 28rpx; border-bottom: 1rpx solid var(--border-color); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 40rpx; margin-right: 20rpx; }
.menu-name { flex: 1; font-size: 30rpx; color: var(--text-primary); }
.menu-text { font-size: 26rpx; color: var(--text-secondary); margin-right: 12rpx; }
.menu-arrow { font-size: 32rpx; color: var(--text-tertiary); }

/* 底部 */
.footer { text-align: center; padding: 60rpx 0 32rpx; }
.footer-text { font-size: 22rpx; color: var(--text-tertiary); line-height: 1.8; }
