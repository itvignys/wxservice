<!-- 下单页 -->
<view class="container">
  <!-- 设备信息确认 -->
  <view class="card">
    <view class="card-title">设备信息</view>
    <view class="info-row"><text class="info-label">品类</text><text class="info-value">{{quoteData.category.name}}</text></view>
    <view class="info-row"><text class="info-label">型号</text><text class="info-value">{{quoteData.model.name}}</text></view>
    <view class="info-row"><text class="info-label">成色</text><text class="info-value">{{conditionText}}</text></view>
    <view class="info-row" wx:if="{{configText}}"><text class="info-label">配置</text><text class="info-value">{{configText}}</text></view>
    <view class="divider"></view>
    <view class="info-row"><text class="info-label text-bold">预估回收价</text><text class="info-value price">¥{{totalPriceText}}</text></view>
  </view>

  <!-- 回收方式选择 -->
  <view class="card">
    <view class="card-title">选择回收方式</view>
    <view class="method-list">
      <view class="method-card {{selectedMethod === item.method ? 'selected' : ''}}" wx:for="{{methods}}" wx:key="method" bindtap="selectMethod" data-method="{{item.method}}">
        <view class="method-icon">{{item.icon}}</view>
        <view class="method-info">
          <view class="method-name">{{item.text}}</view>
          <view class="method-desc">{{item.desc}}</view>
        </view>
        <view class="method-check" wx:if="{{selectedMethod === item.method}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 联系信息 -->
  <view class="card">
    <view class="card-title">联系信息</view>
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>

    <!-- 上门回收：地址+预约时间 -->
    <block wx:if="{{selectedMethod === 'onsite'}}">
      <view class="form-item" bindtap="chooseAddress">
        <text class="form-label">上门地址</text>
        <view class="form-value {{form.address ? '' : 'placeholder'}}">{{form.address || '请选择地址'}}</view>
      </view>
      <view class="form-item" bindtap="chooseTime">
        <text class="form-label">预约时间</text>
        <view class="form-value {{form.appointmentTime ? '' : 'placeholder'}}">{{form.appointmentTime || '请选择上门时间'}}</view>
      </view>
    </block>

    <!-- 邮寄回收：选择收货地址 -->
    <block wx:if="{{selectedMethod === 'mail'}}">
      <view class="mail-tip">
        <text>📦 邮寄地址：浙江省杭州市余杭区XX科技园质检中心</text>
        <text class="mail-sub">顺丰到付，收货后24小时内验机</text>
      </view>
    </block>

    <!-- 到店回收：选择网点 -->
    <block wx:if="{{selectedMethod === 'instore'}}">
      <view class="form-item" bindtap="chooseStore">
        <text class="form-label">回收网点</text>
        <view class="form-value {{form.store ? '' : 'placeholder'}}">{{form.store || '请选择回收网点'}}</view>
      </view>
    </block>

    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="补充说明（可选）" value="{{form.remark}}" bindinput="onInput" data-field="remark" />
    </view>
  </view>

  <view style="height:140rpx"></view>

  <!-- 底部固定栏 -->
  <view class="bottom-bar safe-bottom">
    <view class="bar-price">
      <text class="bar-price-label">预估回收价</text>
      <text class="bar-price-val">¥{{totalPriceText}}</text>
    </view>
    <view class="bar-btn" bindtap="submit">提交订单</view>
  </view>
</view>
