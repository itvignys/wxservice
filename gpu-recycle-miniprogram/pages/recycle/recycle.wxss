/* 估价入口页样式 */
.container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: var(--bg-card);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input {
  display: flex;
  align-items: center;
  background: var(--bg-gray);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input input {
  flex: 1;
  font-size: 26rpx;
}

/* Section */
.section {
  margin-top: 28rpx;
  padding: 0 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* 品类网格 */
.cat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.cat-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s;
}

.cat-card:active {
  transform: scale(0.97);
}

.cat-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin: 0 auto 16rpx;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.cat-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 搜索结果 / 型号列表 */
.model-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.model-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.model-left {
  flex: 1;
}

.model-brand {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.model-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.model-spec {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.model-right {
  text-align: right;
}

.model-price-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.model-price {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--danger);
}

/* 最近估价 */
.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-sm);
}

.recent-info {
  flex: 1;
}

.recent-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.recent-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.recent-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--danger);
  margin-right: 20rpx;
}

.recent-btn {
  font-size: 24rpx;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

/* 回收说明 */
.info-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.info-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.info-icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 客服热线 */
.contact-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--bg-card);
  padding: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}

.contact-icon {
  font-size: 28rpx;
}

.contact-text {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}
