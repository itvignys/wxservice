/* 配置详情页样式 */
.container { min-height: 100vh; }
.steps { display: flex; align-items: center; justify-content: center; padding: 28rpx 24rpx; background: var(--bg-card); }
.step { display: flex; flex-direction: column; align-items: center; }
.step-dot { width: 48rpx; height: 48rpx; border-radius: 50%; background: var(--bg-gray); color: var(--text-tertiary); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; }
.step.active .step-dot { background: var(--primary); color: #fff; }
.step-label { font-size: 20rpx; color: var(--text-tertiary); margin-top: 6rpx; }
.step.active .step-label { color: var(--primary); font-weight: 600; }
.step-line { width: 50rpx; height: 4rpx; background: var(--bg-gray); margin: 0 6rpx; margin-bottom: 24rpx; }
.step-line.active { background: var(--primary); }

.section-title { font-size: 30rpx; font-weight: 700; padding: 28rpx 32rpx 16rpx; }
.config-section { padding: 0 24rpx; margin-bottom: 28rpx; }
.config-label { font-size: 28rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 16rpx; }
.option-list { display: flex; flex-direction: column; gap: 12rpx; }
.option-item { display: flex; align-items: center; justify-content: space-between; background: var(--bg-card); border-radius: 12rpx; padding: 24rpx 28rpx; border: 4rpx solid transparent; box-shadow: var(--shadow-sm); }
.option-item.selected { border-color: var(--primary); background: var(--primary-light); }
.option-name { font-size: 28rpx; color: var(--text-primary); }
.option-item.selected .option-name { font-weight: 600; }
.option-add { font-size: 26rpx; color: var(--danger); font-weight: 600; }

.bar-info { flex: 1; }
.bar-label { font-size: 22rpx; color: var(--text-secondary); display: block; }
.bar-value { font-size: 32rpx; font-weight: 700; color: var(--danger); }
.bar-btn { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; padding: 20rpx 56rpx; border-radius: 48rpx; font-size: 30rpx; font-weight: 600; }
