/* 估价结果页样式 */
.container { min-height: 100vh; }

/* 价格Banner */
.price-banner {
  background: linear-gradient(135deg, #2BB673 0%, #1a9e5e 100%);
  padding: 60rpx 32rpx 48rpx;
  text-align: center;
  color: #fff;
}
.price-label { font-size: 26rpx; opacity: 0.9; margin-bottom: 16rpx; }
.price-value { display: flex; align-items: baseline; justify-content: center; }
.price-symbol { font-size: 40rpx; font-weight: 700; margin-right: 8rpx; }
.price-num { font-size: 80rpx; font-weight: 800; }
.price-hint { font-size: 22rpx; opacity: 0.8; margin-top: 20rpx; }

/* 价格构成行 */
.price-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.row-label { font-size: 26rpx; color: var(--text-secondary); }
.row-value { font-size: 28rpx; color: var(--text-primary); font-weight: 600; }
.row-value.price { font-size: 34rpx; color: var(--danger); font-weight: 800; }

/* 设备信息行 */
.info-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.info-label { font-size: 26rpx; color: var(--text-secondary); }
.info-value { font-size: 26rpx; color: var(--text-primary); font-weight: 500; }

/* 照片上传 */
.upload-hint { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 20rpx; }
.upload-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.upload-item { position: relative; width: 100%; aspect-ratio: 1; border-radius: 12rpx; overflow: hidden; }
.upload-img { width: 100%; height: 100%; }
.upload-del { position: absolute; top: 4rpx; right: 4rpx; width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.5); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.upload-add { width: 100%; aspect-ratio: 1; border: 2rpx dashed var(--border-color); border-radius: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.upload-icon { font-size: 48rpx; color: var(--text-tertiary); }
.upload-text { font-size: 22rpx; color: var(--text-secondary); margin-top: 8rpx; }

/* 底部栏 */
.bar-price { flex: 1; }
.bar-price-label { font-size: 22rpx; color: var(--text-secondary); display: block; }
.bar-price-val { font-size: 40rpx; font-weight: 800; color: var(--danger); }
.bar-btn { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; padding: 24rpx 64rpx; border-radius: 48rpx; font-size: 32rpx; font-weight: 600; box-shadow: 0 4rpx 16rpx rgba(43,182,115,0.3); }
