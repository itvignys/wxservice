/* 选成色页样式 */
.container { min-height: 100vh; }
.steps { display: flex; align-items: center; justify-content: center; padding: 28rpx 24rpx; background: var(--bg-card); }
.step { display: flex; flex-direction: column; align-items: center; }
.step-dot { width: 48rpx; height: 48rpx; border-radius: 50%; background: var(--bg-gray); color: var(--text-tertiary); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; }
.step.active .step-dot { background: var(--primary); color: #fff; }
.step-label { font-size: 20rpx; color: var(--text-tertiary); margin-top: 6rpx; }
.step.active .step-label { color: var(--primary); font-weight: 600; }
.step-line { width: 60rpx; height: 4rpx; background: var(--bg-gray); margin: 0 8rpx; margin-bottom: 24rpx; }
.step-line.active { background: var(--primary); }

/* 设备信息 */
.device-info { background: var(--bg-card); margin: 20rpx 24rpx; border-radius: 16rpx; padding: 28rpx; box-shadow: var(--shadow-sm); }
.device-name { font-size: 32rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 8rpx; }
.device-spec { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 12rpx; }
.device-base { font-size: 26rpx; color: var(--danger); font-weight: 600; }

/* 成色列表 */
.section-title { font-size: 30rpx; font-weight: 700; padding: 28rpx 32rpx 16rpx; }
.condition-list { padding: 0 24rpx; }
.condition-card { background: var(--bg-card); border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; box-shadow: var(--shadow-sm); border: 4rpx solid transparent; transition: border-color 0.2s; }
.condition-card.selected { border-color: var(--primary); }
.condition-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.condition-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }
.condition-factor { font-size: 26rpx; color: var(--primary); font-weight: 600; }
.condition-desc { font-size: 24rpx; color: var(--text-secondary); line-height: 1.5; }
.condition-price { margin-top: 12rpx; font-size: 28rpx; color: var(--danger); font-weight: 700; }

/* 底部栏 */
.bar-info { flex: 1; }
.bar-label { font-size: 22rpx; color: var(--text-secondary); display: block; }
.bar-value { font-size: 36rpx; font-weight: 700; color: var(--danger); }
.bar-btn { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; padding: 20rpx 56rpx; border-radius: 48rpx; font-size: 30rpx; font-weight: 600; }
.bar-btn.disabled { background: var(--text-tertiary); }
