<!-- 选成色 -->
<view class="container">
  <!-- 进度指示器 -->
  <view class="steps">
    <view class="step active"><view class="step-dot">✓</view><text class="step-label">选品类</text></view>
    <view class="step-line active"></view>
    <view class="step active"><view class="step-dot">✓</view><text class="step-label">选型号</text></view>
    <view class="step-line active"></view>
    <view class="step active"><view class="step-dot">3</view><text class="step-label">选成色</text></view>
    <view class="step-line"></view>
    <view class="step"><view class="step-dot">4</view><text class="step-label">估价</text></view>
  </view>

  <!-- 已选设备 -->
  <view class="device-info">
    <view class="device-name">{{model.name}}</view>
    <view class="device-spec">{{model.spec}}</view>
    <view class="device-base">基础回收价：¥{{basePriceText}}</view>
  </view>

  <!-- 成色选择 -->
  <view class="section-title">选择设备成色</view>
  <view class="condition-list">
    <view class="condition-card {{selectedCondition === item.level ? 'selected' : ''}}" wx:for="{{conditions}}" wx:key="level" bindtap="selectCondition" data-level="{{item.level}}">
      <view class="condition-header">
        <view class="condition-name">{{item.text}}</view>
        <view class="condition-factor">×{{item.factor}}</view>
      </view>
      <view class="condition-desc">{{item.desc}}</view>
      <view class="condition-price" wx:if="{{selectedCondition === item.level}}">预估价：¥{{item.estimatedPrice}}</view>
    </view>
  </view>

  <view style="height:140rpx"></view>

  <!-- 底部固定栏 -->
  <view class="bottom-bar safe-bottom">
    <view class="bar-info">
      <text class="bar-label">{{selectedConditionText}}</text>
      <text class="bar-value" wx:if="{{estimatedPrice > 0}}">¥{{estimatedPriceText}}</text>
    </view>
    <view class="bar-btn {{selectedCondition ? '' : 'disabled'}}" bindtap="next">下一步</view>
  </view>
</view>
