<view class="chat-container">
  <!-- 服务等级进度条 -->
  <view class="service-progress">
    <view class="progress-item {{serviceLevel >= 0 ? 'active' : ''}}">
      <view class="progress-dot">1</view>
      <text class="progress-label">AI诊断</text>
    </view>
    <view class="progress-line {{serviceLevel >= 1 ? 'active' : ''}}"></view>
    <view class="progress-item {{serviceLevel >= 1 ? 'active' : ''}}">
      <view class="progress-dot">2</view>
      <text class="progress-label">专家咨询</text>
    </view>
    <view class="progress-line {{serviceLevel >= 2 ? 'active' : ''}}"></view>
    <view class="progress-item {{serviceLevel >= 2 ? 'active' : ''}}">
      <view class="progress-dot">3</view>
      <text class="progress-label">上门服务</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="chat-list" scroll-y scroll-into-view="{{scrollToView}}" enhanced show-scrollbar scroll-with-animation scroll-with-animation="true">
    <!-- 欢迎消息 -->
    <view class="chat-item ai" id="msg-welcome">
      <view class="avatar ai-avatar">🤖</view>
      <view class="message ai-message">
        <text class="message-text">您好！我是GPU智修专家助手。请描述您的显卡故障现象，或上传故障图片，我将为您进行初步诊断。</text>
        <view class="quick-actions">
          <text class="quick-title">快速选择常见症状：</text>
          <view class="quick-tags">
            <text class="quick-tag" wx:for="{{quickSymptoms}}" wx:key="index" bindtap="sendQuickMessage" data-text="{{item}}">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 消息列表 -->
    <view wx:for="{{messages}}" wx:key="id" class="chat-item {{item.type}}" id="msg-{{item.id}}">
      <!-- 用户消息 -->
      <block wx:if="{{item.type === 'user'}}">
        <view class="message user-message">
          <text class="message-text" wx:if="{{item.contentType === 'text'}}">{{item.content}}</text>
          <image class="message-image" wx:if="{{item.contentType === 'image'}}" src="{{item.content}}" mode="widthFix" bindtap="previewImage" data-url="{{item.content}}"/>
        </view>
        <view class="avatar user-avatar">👤</view>
      </block>

      <!-- AI消息 -->
      <block wx:if="{{item.type === 'ai'}}">
        <view class="avatar ai-avatar">🤖</view>
        <view class="message ai-message">
          <text class="message-text" wx:if="{{item.contentType === 'text'}}">{{item.content}}</text>
          <!-- 知识库匹配结果 -->
          <view wx:if="{{item.knowledgeMatch}}" class="knowledge-card">
            <view class="knowledge-header">
              <text class="knowledge-icon">📚</text>
              <text class="knowledge-title">知识库匹配</text>
              <text class="knowledge-score">匹配度{{item.matchScore}}%</text>
            </view>
            <view class="knowledge-content">
              <view class="knowledge-row">
                <text class="knowledge-label">问题：</text>
                <text class="knowledge-value">{{item.knowledgeMatch.question}}</text>
              </view>
              <view class="knowledge-row">
                <text class="knowledge-label">常见原因：</text>
                <text class="knowledge-value">{{item.knowledgeMatch.causes}}</text>
              </view>
              <view class="knowledge-row">
                <text class="knowledge-label">排查方法：</text>
                <text class="knowledge-value">{{item.knowledgeMatch.diagnosis}}</text>
              </view>
              <view class="knowledge-row">
                <text class="knowledge-label">维修方案：</text>
                <text class="knowledge-value">{{item.knowledgeMatch.solution}}</text>
              </view>
            </view>
            <view class="knowledge-footer">
              <text class="difficulty">难度：{{item.knowledgeMatch.difficulty}}</text>
              <text class="success-rate">成功率：{{item.knowledgeMatch.successRate}}</text>
            </view>
          </view>
          <!-- 元宝AI回复 -->
          <view wx:if="{{item.isYuanbao}}" class="yuanbao-badge">
            <text class="yuanbao-icon">💡</text>
            <text class="yuanbao-text">元宝AI解答</text>
          </view>
          <!-- 升级服务按钮 -->
          <view wx:if="{{item.showUpgrade}}" class="upgrade-section">
            <view class="upgrade-divider">
              <text class="divider-text">未解决问题？</text>
            </view>
            <view class="upgrade-options">
              <button class="upgrade-btn expert" bindtap="contactExpert" wx:if="{{serviceLevel < 1}}">
                <text class="btn-icon">👨‍🔧</text>
                <view class="btn-info">
                  <text class="btn-title">联系专家</text>
                  <text class="btn-desc">免费电话咨询</text>
                </view>
              </button>
              <button class="upgrade-btn onsite" bindtap="bookOnsite" wx:if="{{serviceLevel < 2 && companyInfo}}">
                <text class="btn-icon">🚪</text>
                <view class="btn-info">
                  <text class="btn-title">预约上门</text>
                  <text class="btn-desc">免费检测服务</text>
                </view>
              </button>
              <button class="upgrade-btn onsite disabled" wx:if="{{serviceLevel < 2 && !companyInfo}}">
                <text class="btn-icon">🚪</text>
                <view class="btn-info">
                  <text class="btn-title">预约上门</text>
                  <text class="btn-desc">需完善企业信息</text>
                </view>
              </button>
            </view>
          </view>
        </view>
      </block>

      <!-- 系统消息 -->
      <block wx:if="{{item.type === 'system'}}">
        <view class="system-notice">{{item.content}}</view>
      </block>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{isLoading}}" class="chat-item ai">
      <view class="avatar ai-avatar">🤖</view>
      <view class="message ai-message">
        <view class="typing-indicator">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
    
    <!-- 底部占位，确保可以滚动到底部 -->
    <view id="scroll-bottom" style="height: 40rpx;"></view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area" id="input-area">
    <view class="input-toolbar">
      <view class="toolbar-btn" bindtap="chooseImage">
        <text class="toolbar-icon">📷</text>
        <text class="toolbar-text">图片</text>
      </view>
      <view class="toolbar-btn" bindtap="showKnowledgeBase">
        <text class="toolbar-icon">📚</text>
        <text class="toolbar-text">知识库</text>
      </view>
      <view class="toolbar-btn" bindtap="contactExpert">
        <text class="toolbar-icon">👨‍🔧</text>
        <text class="toolbar-text">专家</text>
      </view>
    </view>
    <view class="input-box">
      <textarea 
        class="input-textarea" 
        placeholder="描述您的显卡故障现象..."
        value="{{inputMessage}}"
        bindinput="onInput"
        bindkeyboardheightchange="onKeyboardHeightChange"
        maxlength="500"
        auto-height
        confirm-type="send"
        bindconfirm="sendMessage"
        show-confirm-bar="{{false}}"
        hold-keyboard
      />
      <button class="send-btn {{inputMessage ? 'active' : ''}}" bindtap="sendMessage">
        <text class="send-icon">➤</text>
      </button>
    </view>
  </view>
</view>