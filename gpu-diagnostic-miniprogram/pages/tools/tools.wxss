.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 顶部卡片 */
.header-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #065A82, #1C7293);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-right: 30rpx;
}

.header-content {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.5;
}

/* 区块标题 */
.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

/* 教程列表 */
.tutorial-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.tutorial-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.tutorial-item:last-child {
  border-bottom: none;
}

.tutorial-item.active {
  background: #f8f9fa;
}

.step-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-info {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 8rpx;
}

.step-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.step-arrow {
  font-size: 24rpx;
  color: #ccc;
  margin-left: 20rpx;
}

.step-content {
  padding: 0 30rpx 30rpx 98rpx;
}

.step-detail {
  background: #f0f7ff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.detail-text {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.detail-tips {
  padding-top: 20rpx;
  border-top: 1rpx dashed #d0e3ff;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.tips-content {
  display: block;
  font-size: 26rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* 工具卡片 */
.tool-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tool-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.tool-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f0f7ff, #e8f4f8);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.tool-info {
  flex: 1;
}

.tool-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
}

.tool-version {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.tool-badge {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tool-badge.free {
  background: rgba(2,195,154,0.1);
  color: var(--accent);
}

.tool-badge.pro {
  background: rgba(255,149,0,0.1);
  color: #FF9500;
}

.tool-desc {
  font-size: 28rpx;
  color: var(--text-light);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.tool-features {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.feature-tag {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

.feature-dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--primary);
  border-radius: 50%;
  margin-right: 12rpx;
}

.feature-text {
  font-size: 24rpx;
  color: var(--text);
}

.tool-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.tool-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.download-btn {
  min-width: 140rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  margin: 0;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.download-btn::after {
  border: none;
}

.download-btn[disabled] {
  background: #ccc;
}

.download-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.progress-bar {
  width: 80rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 20rpx;
  color: #fff;
}

/* FAQ */
.faq-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.faq-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.q-mark {
  width: 40rpx;
  height: 40rpx;
  background: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.q-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
}

.q-arrow {
  font-size: 24rpx;
  color: #ccc;
  margin-left: 20rpx;
}

.faq-answer {
  display: flex;
  padding: 0 30rpx 30rpx 30rpx;
}

.a-mark {
  width: 40rpx;
  height: 40rpx;
  background: var(--accent);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.a-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-light);
  line-height: 1.8;
}

/* 底部提示 */
.footer-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(2,195,154,0.1), rgba(6,90,130,0.1));
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.5;
}

.tip-btn {
  padding: 16rpx 28rpx;
  background: var(--accent);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 10rpx;
  margin: 0 0 0 16rpx;
  line-height: 1.4;
}

.tip-btn::after {
  border: none;
}
