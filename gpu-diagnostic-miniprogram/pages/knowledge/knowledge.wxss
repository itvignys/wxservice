.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-icon {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

/* 分类筛选 */
.category-bar {
  background: #fff;
  border-bottom: 1rpx solid #eee;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.category-item.active {
  background: var(--primary);
}

.category-name {
  font-size: 26rpx;
  color: #666;
}

.category-item.active .category-name {
  color: #fff;
  font-weight: 500;
}

.category-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
  background: rgba(0,0,0,0.05);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.category-item.active .category-count {
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.2);
}

/* 知识列表 */
.knowledge-list {
  flex: 1;
  padding: 20rpx;
}

.knowledge-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.knowledge-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.category-tag {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.difficulty-badge {
  display: flex;
  align-items: center;
}

.difficulty-text {
  font-size: 24rpx;
  color: #999;
}

.difficulty-stars {
  font-size: 24rpx;
  color: #FF9500;
  margin-left: 6rpx;
}

.knowledge-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.knowledge-brief {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.brief-row {
  display: flex;
}

.brief-label {
  font-size: 26rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.brief-content {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.knowledge-footer {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.footer-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}

.footer-item.arrow {
  margin-left: auto;
  margin-right: 0;
}

.footer-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-light);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx;
}

.load-text {
  font-size: 24rpx;
  color: #999;
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-category {
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  max-height: 60vh;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 30rpx;
}

.detail-section {
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-section:last-of-type {
  border-bottom: none;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.section-content {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.8;
  padding-left: 44rpx;
}

.detail-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-top: 10rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.stat-value.success {
  color: var(--accent);
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin: 0;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.action-btn.consult {
  background: #f5f5f5;
  color: var(--text);
}

.action-btn.diagnose {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
