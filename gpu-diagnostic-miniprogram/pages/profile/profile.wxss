/* 页面容器 - 浅色主题 */
page {
  background-color: #f5f5f5;
}

.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #065A82 0%, #1C7293 100%);
  margin: 20rpx;
  border-radius: 24rpx;
  padding: 40rpx 30rpx 30rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(6,90,130,0.2);
}

.user-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

.avatar-wrapper {
  position: relative;
  margin-right: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.15);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255,255,255,0.3);
}

.avatar-icon {
  font-size: 60rpx;
}

.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.user-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  width: fit-content;
}

.user-tag.vip {
  background: linear-gradient(135deg, rgba(255,215,0,0.3), rgba(255,165,0,0.3));
  color: #FFD700;
  border: 1rpx solid rgba(255,215,0,0.4);
}

.login-type-tag {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

.logout-btn {
  padding: 12rpx 24rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(255,255,255,0.2);
}

.logout-btn:active {
  background: rgba(255,255,255,0.25);
}

/* 数据统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  position: relative;
  z-index: 1;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.15);
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 分区卡片 */
.section-card {
  background: #ffffff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f8f9fa;
  border-radius: 12rpx;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-emoji {
  font-size: 32rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.menu-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.menu-badge.warning {
  background: rgba(255,193,7,0.15);
  color: #FF8C00;
}

.menu-badge.success {
  background: rgba(2,195,154,0.15);
  color: #02C39A;
}

.menu-extra {
  font-size: 26rpx;
  color: #999999;
  margin-right: 16rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cccccc;
  font-weight: 300;
}

/* 客服热线 */
.hotline-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  margin-top: 20rpx;
}

.hotline-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.hotline-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #065A82;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.hotline-time {
  font-size: 22rpx;
  color: #999999;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 20rpx;
  font-size: 22rpx;
  color: #cccccc;
}

/* 登录弹窗 */
.login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.login-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.login-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.login-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

/* 微信登录 */
.wx-login-section {
  margin-bottom: 30rpx;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  background: #07C160;
  border-radius: 16rpx;
  gap: 16rpx;
}

.wx-login-btn:active {
  opacity: 0.85;
}

.wx-icon {
  font-size: 40rpx;
}

.wx-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

/* 分割线 */
.login-divider {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #999;
}

/* 手机号登录 */
.phone-login-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input-row {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-right: 20rpx;
  border-right: 1rpx solid #ddd;
  padding-right: 20rpx;
}

.phone-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.code-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.send-code-btn {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #065A82, #1C7293);
  border-radius: 12rpx;
  margin-left: 16rpx;
  white-space: nowrap;
}

.send-code-btn text {
  font-size: 24rpx;
  color: #fff;
}

.send-code-btn.disabled {
  background: #ccc;
}

.login-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #065A82, #1C7293);
  border-radius: 16rpx;
  margin-top: 10rpx;
}

.login-submit-btn text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.login-submit-btn.disabled {
  background: #ccc;
}

.login-tips {
  text-align: center;
  margin-top: 24rpx;
}

.login-tips text {
  font-size: 24rpx;
  color: #999;
}
