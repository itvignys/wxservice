<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info">
      <view class="avatar-wrapper">
        <image class="avatar" wx:if="{{isLoggedIn && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
        <view class="avatar-placeholder" wx:else>
          <text class="avatar-icon">👤</text>
        </view>
      </view>
      <view class="user-meta">
        <text class="user-name" wx:if="{{isLoggedIn}}">{{userInfo.nickname || (loginType === 'phone' ? '手机号用户' : '微信用户')}}</text>
        <text class="user-name" wx:else bindtap="handleLogin">点击登录</text>
        <view class="user-tag {{serviceLevel > 0 ? 'vip' : ''}}">
          <text>{{serviceLevelName}}</text>
        </view>
        <text class="login-type-tag" wx:if="{{isLoggedIn}}">{{loginType === 'phone' ? '📱 手机号登录' : '💬 微信登录'}}</text>
      </view>
      <view class="logout-btn" wx:if="{{isLoggedIn}}" bindtap="onLogout">
        <text>退出</text>
      </view>
    </view>
    <!-- 数据统计 -->
    <view class="stats-bar">
      <view class="stat-box" bindtap="goToConsultHistory">
        <text class="stat-num">{{stats.consultCount}}</text>
        <text class="stat-label">咨询次数</text>
      </view>
      <view class="stat-box" bindtap="goToAppointments">
        <text class="stat-num">{{stats.appointmentCount}}</text>
        <text class="stat-label">预约记录</text>
      </view>
      <view class="stat-box" bindtap="goToOrders">
        <text class="stat-num">{{stats.orderCount}}</text>
        <text class="stat-label">维修订单</text>
      </view>
    </view>
  </view>

  <!-- 我的服务 -->
  <view class="section-card">
    <view class="section-title">我的服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAppointments">
        <view class="menu-icon" style="background: rgba(6,90,130,0.1);">
          <text class="menu-emoji">📅</text>
        </view>
        <text class="menu-text">预约记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToOrders">
        <view class="menu-icon" style="background: rgba(2,195,154,0.1);">
          <text class="menu-emoji">📋</text>
        </view>
        <text class="menu-text">维修订单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToConsultHistory">
        <view class="menu-icon" style="background: rgba(88,86,214,0.1);">
          <text class="menu-emoji">💬</text>
        </view>
        <text class="menu-text">咨询历史</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-icon" style="background: rgba(255,149,0,0.1);">
          <text class="menu-emoji">⭐</text>
        </view>
        <text class="menu-text">收藏知识</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 企业信息 -->
  <view class="section-card">
    <view class="section-title">企业信息</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToCompanyAuth">
        <view class="menu-icon" style="background: rgba(6,90,130,0.1);">
          <text class="menu-emoji">🏢</text>
        </view>
        <view class="menu-content">
          <text class="menu-text">企业认证</text>
          <text class="menu-badge {{companyInfo ? 'success' : 'warning'}}">{{companyInfo ? '已认证' : '未认证'}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="section-card">
    <view class="section-title">设置</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="openSubscribeSettings">
        <view class="menu-icon" style="background: rgba(255,149,0,0.1);">
          <text class="menu-emoji">🔔</text>
        </view>
        <text class="menu-text">消息通知</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="clearCache">
        <view class="menu-icon" style="background: rgba(255,59,48,0.1);">
          <text class="menu-emoji">🗑️</text>
        </view>
        <text class="menu-text">清除缓存</text>
        <text class="menu-extra">{{cacheSize}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <view class="menu-icon" style="background: rgba(142,142,147,0.1);">
          <text class="menu-emoji">ℹ️</text>
        </view>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToFeedback">
        <view class="menu-icon" style="background: rgba(88,86,214,0.1);">
          <text class="menu-emoji">📝</text>
        </view>
        <text class="menu-text">意见反馈</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="contactService">
        <view class="menu-icon" style="background: rgba(2,195,154,0.1);">
          <text class="menu-emoji">🎧</text>
        </view>
        <text class="menu-text">联系客服</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 客服热线 -->
  <view class="hotline-section">
    <text class="hotline-label">客服热线</text>
    <text class="hotline-number" bindtap="callHotline">138-2658-0396</text>
    <text class="hotline-time">服务时间 9:00-21:00</text>
  </view>

  <!-- 版本号 -->
  <view class="version-info">
    <text>GPU维修助手 v{{appVersion}}</text>
  </view>

  <!-- 登录弹窗 -->
  <view class="login-mask" wx:if="{{showLoginPanel}}" bindtap="onCloseLoginPanel">
    <view class="login-panel" catchtap="noop">
      <view class="login-header">
        <text class="login-title">登录 / 注册</text>
        <text class="login-close" bindtap="onCloseLoginPanel">✕</text>
      </view>

      <!-- 微信一键登录 -->
      <view class="wx-login-section">
        <view class="wx-login-btn" bindtap="onWxLogin">
          <text class="wx-icon">💬</text>
          <text class="wx-text">微信一键登录</text>
        </view>
      </view>

      <view class="login-divider">
        <view class="divider-line"></view>
        <text class="divider-text">或</text>
        <view class="divider-line"></view>
      </view>

      <!-- 手机号登录 -->
      <view class="phone-login-section">
        <view class="input-row">
          <text class="input-label">+86</text>
          <input
            class="phone-input"
            type="number"
            placeholder="请输入手机号"
            maxlength="11"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
        </view>
        <view class="input-row">
          <input
            class="code-input"
            type="number"
            placeholder="请输入验证码"
            maxlength="6"
            value="{{verifyCode}}"
            bindinput="onCodeInput"
          />
          <view class="send-code-btn {{countdown > 0 || isSending ? 'disabled' : ''}}" bindtap="onSendCode">
            <text>{{countdown > 0 ? countdown + 's' : (isSending ? '发送中...' : '获取验证码')}}</text>
          </view>
        </view>
        <view class="login-submit-btn {{isLogining ? 'disabled' : ''}}" bindtap="onPhoneLogin">
          <text>{{isLogining ? '登录中...' : '手机号登录'}}</text>
        </view>
      </view>

      <view class="login-tips">
        <text>未注册手机号验证后将自动创建账号</text>
      </view>
    </view>
  </view>
</view>
