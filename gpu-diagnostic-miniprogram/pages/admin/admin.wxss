.admin-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.stats-section {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #065A82, #1C7293);
}

.stats-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10rpx);
}

.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* 数据看板 */
.dashboard-section {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.dashboard-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}

.dashboard-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.dashboard-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 满意度 */
.satisfaction-bar {
  display: flex;
  gap: 40rpx;
}

.satisfaction-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
}

.satisfaction-item.like {
  background: rgba(2,195,154,0.1);
}

.satisfaction-item.dislike {
  background: rgba(255,59,48,0.1);
}

.satisfaction-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.satisfaction-count {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 4rpx;
}

.satisfaction-label {
  font-size: 24rpx;
  color: #999;
}

/* 热门问题 */
.top-question-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.top-question-item:last-child {
  border-bottom: none;
}

.top-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #065A82;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.top-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 每日对话量 */
.daily-stats-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.daily-stat-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.daily-date {
  width: 160rpx;
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.daily-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.daily-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #065A82, #02C39A);
  border-radius: 8rpx;
  min-width: 4rpx;
}

.daily-count {
  width: 60rpx;
  font-size: 22rpx;
  color: #333;
  text-align: right;
  flex-shrink: 0;
}

/* 操作按钮 */
.action-section {
  padding: 24rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #02C39A, #00B894);
  box-shadow: 0 4rpx 16rpx rgba(2,195,154,0.25);
}

.action-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.action-btn.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.action-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.action-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

/* 搜索区 */
.search-section {
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-icon {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

/* 历史检索结果 */
.history-section {
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.history-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.history-question {
  font-size: 28rpx;
  font-weight: 600;
  color: #065A82;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.history-answer {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.history-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

/* 待确认列表 */
.pending-section {
  padding: 0 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-top: 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 知识卡片 */
.knowledge-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.card-id {
  font-size: 22rpx;
  color: #ccc;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.card-preview {
  display: flex;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.preview-label {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.preview-text {
  font-size: 26rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.card-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #999;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.btn-view {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f5f7fa;
  border: 1rpx solid #e0e0e0;
}

.btn-view text {
  font-size: 26rpx;
  color: #666;
}

.btn-confirm {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #02C39A;
}

.btn-confirm text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.btn-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  border-radius: 10rpx;
  background: #fff;
  border: 1rpx solid #FF3B30;
}

.btn-delete text {
  font-size: 26rpx;
  color: #FF3B30;
}

.btn-view:active,
.btn-confirm:active,
.btn-delete:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
  line-height: 1.5;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  gap: 12rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  background: #065A82;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

.loading-text {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
}

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.detail-modal {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-category {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.detail-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.detail-body {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.5;
  margin-bottom: 30rpx;
}

.detail-block {
  margin-bottom: 24rpx;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.detail-footer {
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-confirm-large {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #02C39A, #00B894);
}

.btn-confirm-large text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.btn-confirm-large:active {
  opacity: 0.9;
}
