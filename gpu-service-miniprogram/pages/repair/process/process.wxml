<view class="container">
  <view class="form-section">
    <view class="section-title">维修过程记录</view>
    <view class="form-group">
      <text class="form-label">维修步骤</text>
      <view class="step-list">
        <view class="step-item" wx:for="{{stepRecords}}" wx:key="index">
          <view class="step-header">
            <text class="step-num">步骤{{index + 1}}</text>
            <view class="step-del" bindtap="deleteStep" data-index="{{index}}">删除</view>
          </view>
          <textarea class="step-desc" placeholder="描述维修操作" value="{{item.desc}}" bindinput="onStepInput" data-index="{{index}}" data-field="desc" />
        </view>
      </view>
      <view class="add-step" bindtap="addStep">+ 添加步骤</view>
    </view>
    <view class="form-group">
      <text class="form-label">更换配件</text>
      <view class="parts-list">
        <view class="part-item" wx:for="{{partsReplaced}}" wx:key="index">
          <input class="part-name" placeholder="配件名称" value="{{item.name}}" bindinput="onPartInput" data-index="{{index}}" data-field="name" />
          <input class="part-count" type="number" placeholder="数量" value="{{item.count}}" bindinput="onPartInput" data-index="{{index}}" data-field="count" />
          <view class="part-del" bindtap="deletePart" data-index="{{index}}">✕</view>
        </view>
      </view>
      <view class="add-part" bindtap="addPart">+ 添加配件</view>
    </view>
    <view class="form-group">
      <text class="form-label">实际工时(小时)</text>
      <input class="form-input" type="digit" placeholder="如: 3.5" value="{{form.actualHours}}" bindinput="onInput" data-field="actualHours" />
    </view>
    <view class="form-group">
      <text class="form-label">维修结果</text>
      <textarea class="form-textarea" placeholder="请描述维修结果" value="{{form.repairResult}}" bindinput="onInput" data-field="repairResult" />
    </view>
    <view class="form-group">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="备注（选填）" value="{{form.repairRemark}}" bindinput="onInput" data-field="repairRemark" />
    </view>
  </view>

  <view class="btn-area">
    <button class="btn-primary" bindtap="submitProcess" loading="{{submitting}}">提交维修记录</button>
  </view>
</view>
