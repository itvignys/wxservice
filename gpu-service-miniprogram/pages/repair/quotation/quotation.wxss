.container { padding-bottom: 200rpx; }

.form-section {
  margin: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx; font-weight: bold; color: var(--text-primary);
  margin-bottom: 24rpx; display: flex; align-items: center;
}

.section-title::before {
  content: ''; width: 6rpx; height: 28rpx;
  background: linear-gradient(180deg, var(--primary), var(--secondary));
  margin-right: 16rpx; border-radius: 3rpx;
}

.form-group { margin-bottom: 24rpx; }
.form-group:last-child { margin-bottom: 0; }

.form-label {
  display: block; font-size: 26rpx; color: var(--text-secondary); margin-bottom: 12rpx;
}

.form-input {
  background: rgba(255, 255, 255, 0.05); border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: var(--text-primary);
}

.form-textarea {
  background: rgba(255, 255, 255, 0.05); border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: var(--text-primary);
  width: 100%; height: 140rpx; box-sizing: border-box;
}

/* 费用列表 */
.fee-list { margin-bottom: 12rpx; }

.fee-item {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx;
}

.fee-name {
  flex: 2; background: rgba(255, 255, 255, 0.05); border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; color: var(--text-primary);
}

.fee-amount {
  flex: 1; background: rgba(255, 255, 255, 0.05); border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; color: var(--text-primary);
}

.fee-del {
  width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center;
  color: var(--accent); font-size: 28rpx;
}

.add-fee {
  text-align: center; padding: 16rpx; color: var(--primary); font-size: 26rpx;
  border: 2rpx dashed rgba(74, 144, 217, 0.3); border-radius: 12rpx;
}

/* 汇总 */
.summary-card {
  margin: 20rpx; background: var(--bg-card); border-radius: 16rpx; padding: 24rpx 30rpx;
}

.summary-row {
  display: flex; justify-content: space-between; padding: 12rpx 0;
}

.summary-label { font-size: 26rpx; color: var(--text-secondary); }
.summary-value { font-size: 28rpx; color: var(--text-primary); }
.summary-value.discount { color: var(--accent); }
.summary-value.accent { font-size: 36rpx; font-weight: bold; color: var(--accent); }
.summary-row.total { border-top: 2rpx solid rgba(255, 255, 255, 0.1); margin-top: 8rpx; padding-top: 16rpx; }

.btn-area {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--bg-dark);
}

.btn-area .btn-primary { width: 100%; }
