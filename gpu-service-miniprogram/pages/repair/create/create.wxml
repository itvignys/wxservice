<view class="container">
  <view class="form-section">
    <view class="section-title">设备信息</view>
    <view class="form-group">
      <text class="form-label">设备类型</text>
      <picker mode="selector" range="{{deviceTypes}}" bindchange="onDeviceTypeChange">
        <view class="form-picker {{form.deviceType ? '' : 'placeholder'}}">
          {{form.deviceType || '请选择设备类型'}}
        </view>
      </picker>
    </view>
    <view class="form-group">
      <text class="form-label">品牌型号</text>
      <input class="form-input" placeholder="如: NVIDIA RTX 4090" value="{{form.brandModel}}" bindinput="onInput" data-field="brandModel" />
    </view>
    <view class="form-group">
      <text class="form-label">序列号</text>
      <input class="form-input" placeholder="设备序列号（选填）" value="{{form.serialNo}}" bindinput="onInput" data-field="serialNo" />
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">故障描述</view>
    <view class="form-group">
      <text class="form-label">故障详情</text>
      <textarea class="form-textarea" placeholder="请描述设备故障情况" value="{{form.faultDesc}}" bindinput="onInput" data-field="faultDesc" maxlength="500" />
      <text class="char-count">{{form.faultDesc.length || 0}}/500</text>
    </view>
    <view class="form-group">
      <text class="form-label">故障照片</text>
      <view class="image-list">
        <view class="image-item" wx:for="{{faultImages}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" />
          <view class="image-del" bindtap="deleteImage" data-index="{{index}}">✕</view>
        </view>
        <view class="image-add" bindtap="chooseImage" wx:if="{{faultImages.length < 6}}">
          <text class="add-icon">+</text>
          <text class="add-text">添加照片</text>
        </view>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">服务信息</view>
    <view class="form-group">
      <text class="form-label">服务方式</text>
      <view class="radio-group">
        <view class="radio-item {{form.serviceType === 'onsite' ? 'active' : ''}}" bindtap="onServiceTypeChange" data-value="onsite">上门</view>
        <view class="radio-item {{form.serviceType === 'instore' ? 'active' : ''}}" bindtap="onServiceTypeChange" data-value="instore">到店</view>
        <view class="radio-item {{form.serviceType === 'mail' ? 'active' : ''}}" bindtap="onServiceTypeChange" data-value="mail">寄修</view>
      </view>
    </view>
    <view class="form-group" wx:if="{{form.serviceType === 'onsite'}}">
      <text class="form-label">上门地址</text>
      <input class="form-input" placeholder="请输入详细地址" value="{{form.customerAddress}}" bindinput="onInput" data-field="customerAddress" />
    </view>
    <view class="form-group">
      <text class="form-label">紧急程度</text>
      <view class="radio-group">
        <view class="radio-item {{form.urgency === 'normal' ? 'active' : ''}}" bindtap="onUrgencyChange" data-value="normal">普通</view>
        <view class="radio-item urgent {{form.urgency === 'urgent' ? 'active' : ''}}" bindtap="onUrgencyChange" data-value="urgent">加急</view>
        <view class="radio-item emergency {{form.urgency === 'emergency' ? 'active' : ''}}" bindtap="onUrgencyChange" data-value="emergency">紧急</view>
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">期望时间</text>
      <picker mode="date" value="{{form.expectedTime}}" bindchange="onDateChange">
        <view class="form-picker {{form.expectedTime ? '' : 'placeholder'}}">
          {{form.expectedTime || '请选择期望维修时间'}}
        </view>
      </picker>
    </view>
  </view>

  <view class="form-section" wx:if="{{isEdit}}">
    <view class="form-group">
      <text class="form-label">关联旧工单</text>
      <input class="form-input" placeholder="质保期内可填旧工单号（选填）" value="{{form.relatedOrderNo}}" bindinput="onInput" data-field="relatedOrderNo" />
    </view>
  </view>

  <view class="btn-area">
    <button class="btn-primary" bindtap="submitOrder" loading="{{submitting}}" disabled="{{submitting}}">
      {{isEdit ? '修改工单' : '提交报修'}}
    </button>
  </view>
</view>
