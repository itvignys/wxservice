.container { padding-bottom: 140rpx; }

.form-section { margin: 20rpx; background: var(--bg-card); border-radius: 16rpx; padding: 30rpx; }

.section-title {
  font-size: 30rpx; font-weight: bold; color: var(--text-primary);
  margin-bottom: 24rpx; display: flex; align-items: center;
}

.section-title::before {
  content: ''; width: 6rpx; height: 28rpx;
  background: linear-gradient(180deg, var(--primary), var(--secondary));
  margin-right: 16rpx; border-radius: 3rpx;
}

.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--text-secondary); margin-bottom: 12rpx; }

.form-textarea {
  background: rgba(255, 255, 255, 0.05); border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: var(--text-primary);
  width: 100%; height: 140rpx; box-sizing: border-box;
}

.radio-group { display: flex; gap: 16rpx; }

.radio-item {
  flex: 1; text-align: center; padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.05); border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx; font-size: 26rpx; color: var(--text-secondary);
}

.radio-item.active { background: rgba(74, 144, 217, 0.2); border-color: var(--primary); color: var(--primary); }
.radio-item.active.pass { background: rgba(81, 207, 102, 0.2); border-color: var(--success); color: var(--success); }
.radio-item.active.fail { background: rgba(255, 107, 107, 0.2); border-color: var(--accent); color: var(--accent); }

.check-list { display: flex; flex-direction: column; gap: 16rpx; }
.check-item { display: flex; align-items: center; gap: 16rpx; }

.check-toggle {
  width: 40rpx; height: 40rpx; border-radius: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: transparent;
}

.check-toggle.checked {
  background: var(--primary); border-color: var(--primary); color: #fff;
}

.check-name { font-size: 26rpx; color: var(--text-primary); }

.image-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item { position: relative; width: 160rpx; height: 160rpx; }
.image-item image { width: 100%; height: 100%; border-radius: 12rpx; }

.image-del {
  position: absolute; top: -10rpx; right: -10rpx; width: 40rpx; height: 40rpx;
  background: var(--accent); color: #fff; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx;
}

.image-add {
  width: 160rpx; height: 160rpx; background: rgba(255, 255, 255, 0.05);
  border: 2rpx dashed rgba(255, 255, 255, 0.2); border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
}

.add-icon { font-size: 48rpx; color: var(--text-secondary); }

.btn-area {
  position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 30rpx;
  padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom);
  background: var(--bg-dark);
}
.btn-area .btn-primary { width: 100%; }
