.container {
  padding-bottom: 180rpx;
}

/* 状态条 */
.status-bar {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.order-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-family: monospace;
}

/* 进度步骤 */
.progress-section {
  padding: 20rpx 30rpx;
  background: var(--bg-card);
  margin-bottom: 20rpx;
}

.progress-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 8rpx;
}

.step.done .step-dot {
  background: var(--primary);
  box-shadow: 0 0 10rpx rgba(74, 144, 217, 0.5);
}

.step-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.step.done .step-label {
  color: var(--primary);
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 0 8rpx;
  margin-bottom: 30rpx;
}

.step-line.done {
  background: var(--primary);
}

/* 信息卡片 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  padding: 12rpx 0;
}

.info-item .info-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.info-item .info-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.info-value.link {
  color: var(--primary);
  text-decoration: underline;
}

.info-value.pass {
  color: var(--success);
}

.info-value.fail {
  color: var(--accent);
}

.info-value.discount {
  color: var(--accent);
}

/* 故障描述 */
.fault-desc {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fault-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

/* 报价信息 */
.quotation-amount {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.amount-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.amount-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--accent);
}

.quotation-type-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 107, 107, 0.2);
  color: var(--accent);
  margin-left: 12rpx;
  vertical-align: middle;
}

.quotation-type-tag.supplement {
  background: rgba(255, 217, 61, 0.2);
  color: var(--warning);
}

/* 操作区域 */
.action-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--bg-dark);
  display: flex;
  gap: 16rpx;
}

.action-area .btn-primary,
.action-area .btn-secondary,
.action-area .btn-danger {
  flex: 1;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.btn-danger {
  background: var(--accent);
  color: #fff;
  border-radius: 40rpx;
  border: none;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-danger::after {
  border: none;
}
