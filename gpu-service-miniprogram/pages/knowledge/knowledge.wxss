/* 知识库页面样式 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background: var(--bg-card);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--bg-light);
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-placeholder {
  color: var(--text-secondary);
}

/* 分类标签 */
.category-tabs {
  background: var(--bg-card);
  padding: 0 20rpx 20rpx;
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  background: var(--bg-light);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
}

.tab-icon {
  margin-right: 8rpx;
}

/* 问题列表 */
.problem-list {
  flex: 1;
  padding: 20rpx;
}

.problem-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.problem-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.problem-icon {
  width: 72rpx;
  height: 72rpx;
  background: var(--bg-light);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.problem-title-wrap {
  flex: 1;
}

.problem-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.problem-tags {
  display: flex;
  flex-wrap: wrap;
}

.difficulty {
  font-size: 24rpx;
  color: var(--warning);
  letter-spacing: 4rpx;
}

.problem-body {
  padding: 20rpx 0;
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}

.info-row {
  margin-bottom: 16rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  display: inline-block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
  min-width: 120rpx;
}

.info-text {
  font-size: 26rpx;
  color: var(--text-primary);
}

.problem-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.footer-item {
  display: flex;
  align-items: center;
}

.footer-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.footer-value {
  font-size: 26rpx;
  color: var(--accent);
}

.footer-arrow {
  font-size: 26rpx;
  color: var(--primary);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-sub {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 底部咨询栏 */
.consult-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
}

.consult-info {
  flex: 1;
}

.consult-title {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.consult-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.btn-consult {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-consult::after {
  border: none;
}
