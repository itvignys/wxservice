/* 首页样式 */
.container {
  padding-bottom: 40rpx;
}

/* Banner */
.banner {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 60rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.banner::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(74, 144, 217, 0.3) 0%, transparent 70%);
  border-radius: 50%;
}

.banner-content {
  position: relative;
  z-index: 1;
}

.banner-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.5);
}

.banner-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 40rpx;
}

.banner-stats {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 30rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #4a90d9;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx 20rpx;
  background: var(--bg-card);
  margin: 20rpx;
  border-radius: 16rpx;
}

.action-item {
  width: 25%;
  text-align: center;
  padding: 20rpx 0;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin: 0 auto 16rpx;
}

.ai-icon { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.kb-icon { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
.tool-icon { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
.expert-icon { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }

.action-name {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.action-desc {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* 服务阶梯 */
.service-ladder {
  margin: 20rpx;
}

.ladder-steps {
  margin-top: 20rpx;
}

.step-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-light);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.step-num.highlight {
  background: linear-gradient(135deg, #ff6b6b, #ffd93d);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.step-content {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.step-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.step-arrow {
  font-size: 32rpx;
  color: var(--primary);
}

.step-tag {
  background: linear-gradient(135deg, #ff6b6b, #ffd93d);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 热门问题 */
.hot-issues {
  margin: 20rpx;
}

.issue-list {
  margin-bottom: 20rpx;
}

.issue-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}

.issue-item:last-child {
  border-bottom: none;
}

.issue-icon {
  width: 64rpx;
  height: 64rpx;
  background: var(--bg-light);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.issue-info {
  flex: 1;
}

.issue-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
}

.issue-type {
  display: inline-block;
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(74, 144, 217, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.issue-rate {
  font-size: 24rpx;
  color: var(--success);
}

/* 服务承诺 */
.promises {
  margin: 20rpx;
}

.promise-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.promise-item {
  width: 50%;
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.promise-icon {
  width: 36rpx;
  height: 36rpx;
  background: var(--success);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  margin-right: 12rpx;
}

.promise-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
