/* 使用指南页面样式 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-dark);
}

/* 工具头部 */
.tool-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: var(--bg-card);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}

.tool-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.tool-info {
  flex: 1;
}

.tool-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.tool-version {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 内容区域 */
.guide-content {
  flex: 1;
  padding: 20rpx;
}

.section {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}

.section-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* 步骤列表 */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.step-item {
  display: flex;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.step-image {
  margin-top: 16rpx;
  padding: 40rpx;
  background: var(--bg-light);
  border-radius: 12rpx;
  text-align: center;
}

.image-placeholder {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 注意事项 */
.note-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-item {
  display: flex;
  align-items: flex-start;
  background: rgba(255, 217, 61, 0.1);
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid var(--warning);
}

.note-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.note-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

/* FAQ */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.faq-item {
  background: var(--bg-light);
  border-radius: 12rpx;
  padding: 24rpx;
}

.faq-question {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.faq-answer {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.faq-q {
  color: var(--primary);
  font-weight: bold;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.faq-a {
  color: var(--success);
  font-weight: bold;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
}

.btn-back {
  flex: 1;
  background: var(--bg-light);
  color: var(--text-primary);
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.btn-back::after {
  border: none;
}

.btn-download {
  flex: 1;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 40rpx;
  border: none;
}

.btn-download::after {
  border: none;
}
