<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="header-title">🛠️ 检测工具</text>
    <text class="header-subtitle">专业显卡检测软件下载与使用指南</text>
  </view>

  <!-- 工具列表 -->
  <view class="tools-list">
    <view class="tool-card" wx:for="{{tools}}" wx:key="id">
      <view class="tool-header">
        <view class="tool-icon">{{item.icon}}</view>
        <view class="tool-info">
          <text class="tool-name">{{item.name}}</text>
          <text class="tool-version">{{item.version}}</text>
        </view>
        <view class="tool-tag {{item.type}}">{{item.typeText}}</view>
      </view>
      
      <view class="tool-desc">{{item.description}}</view>
      
      <view class="tool-features">
        <view class="feature-item" wx:for="{{item.features}}" wx:for-item="feature" wx:key="index">
          <text class="feature-dot">✓</text>
          <text class="feature-text">{{feature}}</text>
        </view>
      </view>

      <view class="tool-actions">
        <button class="btn-guide" bindtap="goToGuide" data-id="{{item.id}}">
          <text>📖 使用教程</text>
        </button>
        <button class="btn-download" bindtap="downloadTool" data-url="{{item.downloadUrl}}">
          <text>⬇️ 立即下载</text>
        </button>
      </view>
    </view>
  </view>

  <!-- 使用流程 -->
  <view class="card process-card">
    <view class="card-title">本地检测流程</view>
    <view class="process-steps">
      <view class="process-step">
        <view class="step-num">1</view>
        <view class="step-content">
          <text class="step-title">下载工具</text>
          <text class="step-desc">选择适合的检测软件下载</text>
        </view>
      </view>
      <view class="process-step">
        <view class="step-num">2</view>
        <view class="step-content">
          <text class="step-title">运行检测</text>
          <text class="step-desc">按教程操作进行检测</text>
        </view>
      </view>
      <view class="process-step">
        <view class="step-num">3</view>
        <view class="step-content">
          <text class="step-title">获取结果</text>
          <text class="step-desc">查看检测报告和故障代码</text>
        </view>
      </view>
      <view class="process-step">
        <view class="step-num highlight">4</view>
        <view class="step-content">
          <text class="step-title">咨询专家</text>
          <text class="step-desc">上传结果获取维修建议</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 注意事项 -->
  <view class="card tips-card">
    <view class="card-title">⚠️ 注意事项</view>
    <view class="tips-list">
      <view class="tip-item">
        <text class="tip-icon">1</text>
        <text class="tip-text">检测前请关闭其他占用显卡的程序</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">2</text>
        <text class="tip-text">确保显卡驱动已正确安装</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">3</text>
        <text class="tip-text">检测过程中请勿强制关机</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">4</text>
        <text class="tip-text">建议截图保存检测结果</text>
      </view>
    </view>
  </view>

  <!-- 底部咨询 -->
  <view class="consult-section">
    <text class="consult-text">不会使用工具？联系专家远程协助</text>
    <button class="btn-primary" bindtap="goToExpert">联系专家</button>
  </view>
</view>
