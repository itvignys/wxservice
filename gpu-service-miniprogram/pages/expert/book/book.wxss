/* 预约页面样式 */
.container {
  padding-bottom: 180rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 50rpx 40rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 服务信息卡片 */
.service-info-card {
  margin: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.service-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.service-detail {
  flex: 1;
}

.service-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.service-price {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary);
}

/* 表单区域 */
.form-section {
  margin: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}

.form-title .optional {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: normal;
  margin-left: 12rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.form-input, .form-textarea, .form-picker {
  width: 100%;
  height: 80rpx;
  background: var(--bg-light);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-input::placeholder, .form-textarea::placeholder {
  color: var(--text-secondary);
}

.form-textarea {
  height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.form-picker {
  display: flex;
  align-items: center;
}

.form-picker.placeholder {
  color: var(--text-secondary);
}

/* 时间段选择 */
.time-slots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.time-slot {
  padding: 16rpx 30rpx;
  background: var(--bg-light);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}

.time-slot.active {
  background: rgba(78, 205, 196, 0.2);
  color: var(--primary);
  border-color: var(--primary);
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
  z-index: 100;
}

.price-info {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary);
}

.btn-submit {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-submit::after {
  border: none;
}
