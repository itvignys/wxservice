<view class="container">
  <view class="page-header">
    <text class="header-title">预约记录</text>
  </view>

  <view class="booking-list" wx:if="{{bookings.length > 0}}">
    <view class="booking-card" wx:for="{{bookings}}" wx:key="index">
      <view class="booking-header">
        <text class="booking-type">{{item.serviceType === 'phone' ? '电话咨询' : '上门服务'}}</text>
        <text class="booking-status {{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="booking-info">
        <view class="info-row">
          <text class="info-label">联系人：</text>
          <text class="info-value">{{item.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">联系电话：</text>
          <text class="info-value">{{item.phone}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">显卡型号：</text>
          <text class="info-value">{{item.gpuModel}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">预约时间：</text>
          <text class="info-value">{{item.date}} {{item.timeSlot}}</text>
        </view>
        <view class="info-row" wx:if="{{item.companyName}}">
          <text class="info-label">企业名称：</text>
          <text class="info-value">{{item.companyName}}</text>
        </view>
      </view>
      <view class="booking-footer">
        <text class="booking-time">{{item.createTime}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">📅</text>
    <text class="empty-text">暂无预约记录</text>
    <button class="btn-book" bindtap="goToBook">立即预约</button>
  </view>
</view>
