/* 预约记录页面样式 */
.page-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40rpx;
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.booking-list {
  padding: 20rpx;
}

.booking-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.booking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}

.booking-type {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.booking-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.booking-status.pending {
  background: rgba(255, 217, 61, 0.2);
  color: var(--warning);
}

.booking-status.confirmed {
  background: rgba(78, 205, 196, 0.2);
  color: var(--primary);
}

.booking-status.completed {
  background: rgba(81, 207, 102, 0.2);
  color: var(--success);
}

.booking-info {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  width: 160rpx;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.booking-footer {
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
}

.booking-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.btn-book {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-size: 28rpx;
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-book::after {
  border: none;
}
