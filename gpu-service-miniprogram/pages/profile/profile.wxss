/* 个人中心页面样式 */
.container {
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  margin: 20rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-wrapper {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

.avatar-wrapper::after {
  border: none;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.1);
}

.user-info {
  margin-left: 24rpx;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.user-roles {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.role-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(74, 144, 217, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.user-level {
  display: inline-block;
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(78, 205, 196, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 快捷报修 */
.quick-repair {
  display: flex;
  align-items: center;
  margin: 20rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #4a90d9, #5d4e9c);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 144, 217, 0.3);
}

.quick-repair-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.quick-repair-text {
  flex: 1;
}

.quick-repair-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.quick-repair-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.quick-repair-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 徽标 */
.menu-badge {
  background: var(--accent);
  color: #fff;
  font-size: 20rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
}

.menu-badge.warn {
  background: var(--warning);
  color: #1a1a2e;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 30rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.1);
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 菜单区域 */
.menu-section {
  margin: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  overflow: hidden;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 20rpx 30rpx;
  background: rgba(0, 0, 0, 0.2);
}

.menu-list {
  padding: 0 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 10rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  text-align: left;
}

.menu-item::after {
  border: none;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  background: var(--bg-light);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.menu-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.menu-status.unverified {
  background: rgba(255, 217, 61, 0.2);
  color: var(--warning);
}

.menu-status.verified {
  background: rgba(81, 207, 102, 0.2);
  color: var(--success);
}

.menu-value {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-secondary);
}

.contact-item {
  margin: 0;
  padding-left: 0;
  padding-right: 0;
}

/* 底部联系栏 */
.contact-bar {
  margin: 40rpx 30rpx;
  text-align: center;
}

.contact-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.contact-phone {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.contact-time {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 30rpx;
}

.version-info text {
  font-size: 22rpx;
  color: var(--text-secondary);
}
