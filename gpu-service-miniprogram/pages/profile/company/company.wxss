/* 企业认证页面样式 */
.container {
  padding-bottom: 160rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 50rpx 40rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 认证状态卡片 */
.status-card {
  margin: 20rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  text-align: center;
}

.status-card.verified {
  background: rgba(81, 207, 102, 0.1);
  border: 2rpx solid rgba(81, 207, 102, 0.3);
}

.status-card.pending {
  background: rgba(255, 217, 61, 0.1);
  border: 2rpx solid rgba(255, 217, 61, 0.3);
}

.status-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.status-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.status-card.verified .status-title {
  color: var(--success);
}

.status-card.pending .status-title {
  color: var(--warning);
}

.status-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 表单区域 */
.form-section {
  margin: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.form-input, .form-textarea {
  width: 100%;
  background: var(--bg-light);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-input {
  height: 80rpx;
}

.form-input::placeholder, .form-textarea::placeholder {
  color: var(--text-secondary);
}

.form-textarea {
  height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 上传区域 */
.upload-area {
  border: 2rpx dashed rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 60rpx;
  text-align: center;
  background: var(--bg-light);
}

.upload-icon {
  display: block;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.upload-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.upload-preview {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 300rpx;
  background: var(--bg-light);
}

.preview-delete {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(255, 107, 107, 0.9);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

/* 权益说明 */
.benefits-section {
  margin: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.05);
}

.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: var(--bg-light);
  border-radius: 12rpx;
}

.benefit-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.benefit-content {
  flex: 1;
}

.benefit-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.benefit-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
  z-index: 100;
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-size: 30rpx;
  padding: 28rpx 0;
  border-radius: 40rpx;
  border: none;
}

.btn-submit::after {
  border: none;
}

.btn-submit.disabled {
  background: var(--bg-light);
  color: var(--text-secondary);
}
