<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-header">
      <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="user-avatar" src="{{userInfo.avatarUrl || '/assets/images/avatar-default.png'}}" mode="aspectFill"/>
      </button>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '点击登录'}}</text>
        <view class="user-roles" wx:if="{{userRoles.length > 0}}">
          <text class="role-tag" wx:for="{{userRoles}}" wx:key="*this">{{item}}</text>
        </view>
        <text class="user-level" wx:elif="{{userInfo.isEnterprise}}">企业认证用户</text>
        <text class="user-level" wx:else>普通用户</text>
      </view>
    </view>
    <view class="user-stats">
      <view class="stat-item" bindtap="goToMyOrders">
        <text class="stat-num">{{stats.orderCount}}</text>
        <text class="stat-label">我的工单</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.consultCount}}</text>
        <text class="stat-label">咨询次数</text>
      </view>
      <view class="stat-item" bindtap="goToBookings">
        <text class="stat-num">{{stats.bookingCount}}</text>
        <text class="stat-label">预约记录</text>
      </view>
    </view>
  </view>

  <!-- 快捷报修 -->
  <view class="quick-repair" bindtap="goToCreateOrder">
    <view class="quick-repair-icon">🔧</view>
    <view class="quick-repair-text">
      <text class="quick-repair-title">一键报修</text>
      <text class="quick-repair-desc">快速提交维修工单</text>
    </view>
    <text class="quick-repair-arrow">›</text>
  </view>

  <!-- 工单管理入口（按角色动态显示） -->
  <view class="menu-section" wx:if="{{showWorkMenu}}">
    <view class="section-title">工单管理</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToMyOrders">
        <view class="menu-icon order-icon">📋</view>
        <text class="menu-name">我的工单</text>
        <text class="menu-badge" wx:if="{{pendingCount > 0}}">{{pendingCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <!-- 客服入口 -->
      <view class="menu-item" bindtap="goToPendingOrders" wx:if="{{isService || isAdmin}}">
        <view class="menu-icon service-icon">🎧</view>
        <text class="menu-name">待受理工单</text>
        <text class="menu-badge warn" wx:if="{{pendingAcceptCount > 0}}">{{pendingAcceptCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToAllOrders" wx:if="{{isService || isAdmin}}">
        <view class="menu-icon">📊</view>
        <text class="menu-name">全部工单</text>
        <text class="menu-arrow">›</text>
      </view>
      <!-- 工程师入口 -->
      <view class="menu-item" bindtap="goToEngineerTasks" wx:if="{{isEngineer || isAdmin}}">
        <view class="menu-icon engineer-icon">🔧</view>
        <text class="menu-name">工程师任务</text>
        <text class="menu-badge" wx:if="{{engineerTaskCount > 0}}">{{engineerTaskCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <!-- 质检入口 -->
      <view class="menu-item" bindtap="goToInspectionTasks" wx:if="{{isInspector || isAdmin}}">
        <view class="menu-icon inspect-icon">✅</view>
        <text class="menu-name">待质检工单</text>
        <text class="menu-badge" wx:if="{{inspectionCount > 0}}">{{inspectionCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 我的服务 -->
  <view class="menu-section">
    <view class="section-title">我的服务</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToBookings">
        <view class="menu-icon">📅</view>
        <text class="menu-name">预约记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToHistory">
        <view class="menu-icon">💬</view>
        <text class="menu-name">咨询历史</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-icon">⭐</view>
        <text class="menu-name">收藏知识</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 企业信息 -->
  <view class="menu-section">
    <view class="section-title">企业信息</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="editCompanyInfo">
        <view class="menu-icon">🏢</view>
        <view class="menu-content">
          <text class="menu-name">企业认证</text>
          <text class="menu-status {{companyInfo.status}}">{{companyInfo.statusText}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" wx:if="{{companyInfo.name}}">
        <view class="menu-icon">📇</view>
        <view class="menu-content">
          <text class="menu-name">{{companyInfo.name}}</text>
          <text class="menu-sub">{{companyInfo.code}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="menu-section">
    <view class="section-title">设置</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="clearCache">
        <view class="menu-icon">🗑️</view>
        <text class="menu-name">清除缓存</text>
        <text class="menu-value">{{cacheSize}}</text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <view class="menu-icon">ℹ️</view>
        <text class="menu-name">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToFeedback">
        <view class="menu-icon">📝</view>
        <text class="menu-name">意见反馈</text>
        <text class="menu-arrow">›</text>
      </view>
      <button class="menu-item contact-item" open-type="contact">
        <view class="menu-icon">💬</view>
        <text class="menu-name">联系客服</text>
        <text class="menu-arrow">›</text>
      </button>
    </view>
  </view>

  <!-- 客服电话 -->
  <view class="contact-bar">
    <text class="contact-title">客服热线</text>
    <text class="contact-phone" bindtap="callHotline">400-888-8888</text>
    <text class="contact-time">服务时间 9:00-18:00</text>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>GPU维修助手 v1.0.0</text>
  </view>
</view>
