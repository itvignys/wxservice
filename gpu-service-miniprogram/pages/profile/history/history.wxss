/* 咨询历史页面样式 */
.page-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40rpx;
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.history-list {
  padding: 20rpx;
}

.history-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.history-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.history-preview {
  margin-bottom: 20rpx;
}

.preview-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.history-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.05);
}

.message-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.view-detail {
  font-size: 24rpx;
  color: var(--primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.btn-chat {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-size: 28rpx;
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-chat::after {
  border: none;
}

/* 清空按钮 */
.clear-section {
  padding: 40rpx;
  text-align: center;
}

.btn-clear {
  background: var(--bg-light);
  color: var(--text-secondary);
  font-size: 26rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.btn-clear::after {
  border: none;
}
