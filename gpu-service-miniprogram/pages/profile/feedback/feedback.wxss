/* 反馈页面样式 */
.page-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 50rpx 40rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 表单区域 */
.form-section {
  margin: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 反馈类型 */
.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 16rpx 32rpx;
  background: var(--bg-light);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}

.type-item.active {
  background: rgba(78, 205, 196, 0.2);
  color: var(--primary);
  border-color: var(--primary);
}

/* 反馈内容 */
.feedback-textarea {
  width: 100%;
  height: 300rpx;
  background: var(--bg-light);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 1.6;
}

.feedback-textarea::placeholder {
  color: var(--text-secondary);
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

/* 联系方式 */
.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--bg-light);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.form-input::placeholder {
  color: var(--text-secondary);
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx;
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-size: 30rpx;
  padding: 28rpx 0;
  border-radius: 40rpx;
  border: none;
}

.btn-submit::after {
  border: none;
}

.btn-submit.disabled {
  background: var(--bg-light);
  color: var(--text-secondary);
}
