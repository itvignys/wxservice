/* 全局样式 */
page {
  --primary: #4a90d9;
  --secondary: #5d4e9c;
  --accent: #ff6b6b;
  --success: #51cf66;
  --warning: #ffd93d;
  --bg-dark: #1a1a2e;
  --bg-card: #16213e;
  --bg-light: #0f3460;
  --text-primary: #eaeaea;
  --text-secondary: #a0a0a0;
  
  background-color: var(--bg-dark);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 通用卡片样式 */
.card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, var(--primary), var(--secondary));
  margin-right: 16rpx;
  border-radius: 3rpx;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: var(--bg-light);
  color: var(--text-primary);
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  border: 2rpx solid var(--primary);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-primary {
  background: rgba(74, 144, 217, 0.2);
  color: var(--primary);
}

.tag-success {
  background: rgba(81, 207, 102, 0.2);
  color: var(--success);
}

.tag-warning {
  background: rgba(255, 217, 61, 0.2);
  color: var(--warning);
}

.tag-accent {
  background: rgba(255, 107, 107, 0.2);
  color: var(--accent);
}

/* 难度星级 */
.difficulty {
  color: var(--warning);
  font-size: 24rpx;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 30rpx 0;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

/* 安全区域 */
.safe-area {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
